# ==============================================================================
# JavaVerse Canonical Environment Configuration (Part S11)
# ==============================================================================

# Runtime environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL database connection (PostgreSQL 17 + pgvector)
DATABASE_URL=postgresql://javaverse:javaverse@127.0.0.1:5432/javaverse?schema=public

# Redis Queue (BullMQ, AOF persistence, noeviction)
REDIS_QUEUE_URL=redis://127.0.0.1:6379

# Redis Cache (Disposable ephemeral cache, bounded allkeys-lru)
REDIS_CACHE_URL=redis://127.0.0.1:6380

# Application Secrets (Must be 32+ byte random hex strings; run: pnpm generate-env)
SESSION_SECRET=replace_with_32_byte_random_hex_for_session_signing
APP_MASTER_KEY=replace_with_32_byte_random_hex_for_database_encryption
CURSOR_SIGNING_SECRET=replace_with_32_byte_random_hex_for_cursor_signing
SANDBOX_SHARED_SECRET=replace_with_32_byte_random_hex_for_sandbox

# Capacity and Access Control
MAX_USERS=5

# AI Gateway & Limits
AI_PROVIDER_PRIMARY=mock
EXTERNAL_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
EXTERNAL_AI_DAILY_REQUEST_LIMIT_PER_USER=50
EXTERNAL_AI_MAX_CONCURRENCY=2
AI_PROVIDER_EMBED=disabled

# Execution Sandbox (Phase 1 requires mock)
SANDBOX_PROVIDER=mock
SANDBOX_CONTAINER_RUNNER_URL=

# S3-compatible Object Storage (MinIO in local development)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=javaverse-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Outbound Email (Mailpit in local development)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@javaverse.local

# ClamAV Malware Scanner (Optional profile: uploads)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_ENABLED=false
