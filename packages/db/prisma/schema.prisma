datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DeploymentLimits {
  id        Int      @id @default(1)
  maxUsers  Int      @default(5) @map("max_users")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("deployment_limits")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  status          String    @default("ACTIVE")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  consentImprove     Boolean   @default(false) @map("consent_improve")
  displayName        String?   @map("display_name") @db.VarChar(64)
  theme              String    @default("system") @db.VarChar(16)
  defaultJavaVersion String    @default("21") @map("default_java_version") @db.VarChar(16)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  emailTokens         EmailToken[]
  sessions            Session[]
  mfaTotp             MfaTotp?
  recoveryCodes       RecoveryCode[]
  chats               Chat[]
  attachments         Attachment[]
  executions          Execution[]
  feedbacks           Feedback[]
  durableJobs         DurableJob[]
  streamEvents        UserStreamEvent[]
  auditLogsAsActor    AuditLog[]           @relation("AuditLogActor")
  auditLogsAsTarget   AuditLog[]           @relation("AuditLogTarget")
  practiceSubmissions PracticeSubmission[]
  progressEntries     UserProgress[]
  rewards             UserReward?
  badges              UserBadge[]
  flashcards          UserFlashcard[]
  libraryItems        LibraryItem[]
  feedbackReports     FeedbackReport[]     @relation("FeedbackReportAuthor")
  resolvedFeedbacks   FeedbackReport[]     @relation("FeedbackReportResolver")
  kbCandidates        KbCandidate[]        @relation("KbCandidateAuthor")
  reviewedCandidates  KbCandidate[]        @relation("KbCandidateReviewer")

  @@index([status])
  @@map("users")
}

model EmailToken {
  id              String    @id @default(uuid()) @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  otpHash         String?   @map("otp_hash")
  deliveryChannel String    @map("delivery_channel")
  subjectUserId   String?   @map("subject_user_id") @db.Uuid
  subjectEmail    String?   @map("subject_email")
  purpose         String
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  usedAt          DateTime? @map("used_at") @db.Timestamptz
  attempts        Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  subjectUser User? @relation(fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@index([purpose, tokenHash])
  @@index([expiresAt])
  @@map("email_tokens")
}

model Session {
  id            String    @id
  publicId      String    @unique @default(uuid()) @map("public_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz
  reauthAt      DateTime  @default(now()) @map("reauth_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
  @@map("sessions")
}

model MfaTotp {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  secretCiphertext  String    @map("secret_ciphertext")
  lastUsedTimestep  BigInt?   @map("last_used_timestep")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_totp")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model Chat {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  slot      Int      @db.SmallInt
  title     String   @default("New Question")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  state        ChatState?
  messages     Message[]
  durableJobs  DurableJob[]
  streamEvents UserStreamEvent[]

  @@unique([userId, slot])
  @@map("chats")
}

model ChatState {
  chatId    String   @id @map("chat_id") @db.Uuid
  uiState   Json     @default("{}") @map("ui_state")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_state")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  role      String
  content   String
  status    String   @default("SENT")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  chat        Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  parent      Message?     @relation("MessageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Message[]    @relation("MessageHierarchy")
  attachments Attachment[]
  analysis    Analysis?
  executions  Execution[]
  feedbacks   Feedback[]
  feedbackReports FeedbackReport[]

  @@index([chatId, createdAt])
  @@map("messages")
}

model Attachment {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  messageId        String?  @map("message_id") @db.Uuid
  storageKey       String   @unique @map("storage_key")
  originalFileName String   @map("original_file_name")
  safeDisplayName  String   @map("safe_display_name")
  mimeType         String   @map("mime_type")
  sizeBytes        BigInt   @map("size_bytes")
  sha256           String
  scanStatus       String   @default("PENDING") @map("scan_status")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([messageId])
  @@index([sha256])
  @@map("attachments")
}

model Analysis {
  id                 String   @id @default(uuid()) @db.Uuid
  messageId          String   @unique @map("message_id") @db.Uuid
  modelId            String   @map("model_id")
  promptVersion      String   @map("prompt_version")
  result             Json
  verificationStatus String   @default("UNVERIFIED") @map("verification_status")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  message     Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  executions  Execution[]
  durableJobs DurableJob[]
  feedbackReports FeedbackReport[]
  kbCandidates    KbCandidate[]

  @@map("analyses")
}

model Execution {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  analysisId     String?   @map("analysis_id") @db.Uuid
  messageId      String?   @map("message_id") @db.Uuid
  codeHash       String    @map("code_hash")
  javaVersion    String    @map("java_version")
  runnerProvider String    @map("runner_provider")
  status         String
  stdout         String?
  stderr         String?
  exitCode       Int?      @map("exit_code")
  timeMs         Int?      @map("time_ms")
  memoryKb       Int?      @map("memory_kb")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  message  Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([codeHash])
  @@map("executions")
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  vote      Int      @db.SmallInt
  reasons   String[] @default([])
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@map("feedback")
}

model DurableJob {
  id             String    @id @default(uuid()) @db.Uuid
  queue          String
  status         String    @default("PENDING")
  stage          String?
  userId         String?   @map("user_id") @db.Uuid
  chatId         String?   @map("chat_id") @db.Uuid
  analysisId     String?   @map("analysis_id") @db.Uuid
  correlationId  String    @map("correlation_id")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  dedupeKey      String?   @map("dedupe_key")
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz
  progress       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startedAt      DateTime? @map("started_at") @db.Timestamptz
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz

  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  chat         Chat?             @relation(fields: [chatId], references: [id], onDelete: SetNull)
  analysis     Analysis?         @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  streamEvents UserStreamEvent[]

  @@index([queue, status])
  @@index([leaseExpiresAt])
  @@map("durable_jobs")
}

model UserStreamEvent {
  streamSeq   BigInt   @id @default(autoincrement()) @map("stream_seq")
  jobEventSeq Int?     @map("job_event_seq")
  userId      String   @map("user_id") @db.Uuid
  chatId      String?  @map("chat_id") @db.Uuid
  jobId       String?  @map("job_id") @db.Uuid
  eventType   String   @map("event_type")
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat?       @relation(fields: [chatId], references: [id], onDelete: SetNull)
  job  DurableJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, streamSeq])
  @@index([chatId, createdAt])
  @@map("user_stream_events")
}

model IdempotencyRecord {
  key             String
  principalId     String   @map("principal_id")
  route           String
  requestHash     String   @map("request_hash")
  responsePayload Json     @map("response_payload")
  statusCode      Int      @map("status_code")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([principalId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  targetUserId    String?  @map("target_user_id") @db.Uuid
  actorPseudonym  String   @map("actor_pseudonym")
  actorType       String   @map("actor_type")
  action          String
  targetMetadata  Json     @default("{}") @map("target_metadata")
  ipAddress       String?  @map("ip_address")
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  actorUser  User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([targetUserId, occurredAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

model CurriculumLesson {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique @db.VarChar(128)
  title            String   @db.VarChar(255)
  track            String   @db.VarChar(64)
  module           String   @db.VarChar(64)
  orderIndex       Int      @map("order_index")
  published        Boolean  @default(false)
  difficulty       String   @default("EASY") @db.VarChar(32)
  estimatedMinutes Int      @default(15) @map("estimated_minutes")
  hook             String   @db.Text
  contentSimple    String   @map("content_simple") @db.Text
  contentStandard  String   @map("content_standard") @db.Text
  contentDeep      String   @map("content_deep") @db.Text
  visualization    Json
  codeStarter      String   @map("code_starter") @db.Text
  codeSolution     String?  @map("code_solution") @db.Text
  commonMistakes   Json     @map("common_mistakes")
  quiz             Json
  challenge        Json
  javaVersion      String   @default("21") @map("java_version") @db.VarChar(16)
  metadata         Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([track, orderIndex])
  @@index([published])
  @@map("curriculum_lessons")
}

model PracticeProblem {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(128)
  title        String   @db.VarChar(255)
  topic        String   @db.VarChar(64)
  difficulty   String   @default("EASY") @db.VarChar(32)
  orderIndex   Int      @map("order_index")
  prompt       String   @db.Text
  starterCode  String   @map("starter_code") @db.Text
  solutionCode String?  @map("solution_code") @db.Text
  sampleTests  Json     @map("sample_tests")
  hiddenTests  Json     @map("hidden_tests")
  hints        Json
  testHarness  String   @map("test_harness") @db.Text
  published    Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  submissions PracticeSubmission[]

  @@index([topic, difficulty])
  @@index([orderIndex])
  @@map("practice_problems")
}

model PracticeSubmission {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  problemId   String   @map("problem_id") @db.Uuid
  code        String   @db.Text
  status      String   @db.VarChar(32)
  testsPassed Int      @default(0) @map("tests_passed")
  testsTotal  Int      @default(0) @map("tests_total")
  timeMs      Int?     @map("time_ms")
  memoryKb    Int?     @map("memory_kb")
  stdout      String?  @db.Text
  stderr      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem PracticeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId, createdAt(sort: Desc)])
  @@map("practice_submissions")
}

model UserProgress {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  itemType        String    @map("item_type") @db.VarChar(32)
  itemId          String    @map("item_id") @db.VarChar(128)
  completed       Boolean   @default(false)
  score           Int       @default(0)
  lastAttemptedAt DateTime  @default(now()) @map("last_attempted_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  metadata        Json      @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId, itemType, completed])
  @@map("user_progress")
}

model UserReward {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  xp                  Int      @default(0)
  streakDays          Int      @default(0) @map("streak_days")
  lastActivityDate    String?  @map("last_activity_date") @db.VarChar(10)
  gamificationEnabled Boolean  @default(true) @map("gamification_enabled")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_rewards")
}

model UserBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  badgeKey  String   @map("badge_key") @db.VarChar(64)
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@index([userId, awardedAt(sort: Desc)])
  @@map("user_badges")
}

model UserFlashcard {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  front        String   @db.Text
  back         String   @db.Text
  sourceType   String?  @default("quiz_mistake") @map("source_type") @db.VarChar(32)
  sourceId     String?  @map("source_id") @db.VarChar(128)
  intervalDays Int      @default(1) @map("interval_days")
  easeFactor   Float    @default(2.5) @map("ease_factor")
  reviewCount  Int      @default(0) @map("review_count")
  nextReviewAt DateTime @default(now()) @map("next_review_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
  @@map("user_flashcards")
}

model LibraryItem {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  itemType   String   @map("item_type") @db.VarChar(32)
  itemId     String   @map("item_id") @db.VarChar(128)
  title      String   @db.VarChar(255)
  notes      String?  @db.Text
  tags       String[] @default([])
  bookmarked Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId, bookmarked])
  @@map("library_items")
}

model FeedbackReport {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  analysisId String?   @map("analysis_id") @db.Uuid
  messageId  String?   @map("message_id") @db.Uuid
  issueType  String    @map("issue_type") @db.VarChar(32)
  details    String    @db.Text
  status     String    @default("PENDING") @db.VarChar(32)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy String?   @map("resolved_by") @db.Uuid

  user       User      @relation("FeedbackReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  resolver   User?     @relation("FeedbackReportResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  message    Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("feedback_reports")
}

model KbCandidate {
  id                 String    @id @default(uuid()) @db.Uuid
  analysisId         String    @map("analysis_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  status             String    @default("PROPOSED") @db.VarChar(32)
  topic              String    @db.VarChar(64)
  subtopics          String[]  @default([])
  title              String    @db.VarChar(255)
  anonymizedQuestion String    @map("anonymized_question") @db.Text
  verifiedSolution   String    @map("verified_solution") @db.Text
  explanation        String    @db.Text
  reviewedBy         String?   @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz
  rejectionReason    String?   @map("rejection_reason") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user       User     @relation("KbCandidateAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewer   User?    @relation("KbCandidateReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  kbItem     KbItem?

  @@index([status])
  @@index([topic])
  @@index([userId])
  @@map("kb_candidates")
}

model KbItem {
  id          String   @id @default(uuid()) @db.Uuid
  candidateId String?  @unique @map("candidate_id") @db.Uuid
  title       String   @db.VarChar(255)
  topic       String   @db.VarChar(64)
  content     String   @db.Text
  published   Boolean  @default(true)
  sourceType  String   @default("APPROVED_ANALYSIS") @map("source_type") @db.VarChar(32)
  sourceId    String?  @map("source_id") @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  candidate   KbCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Intentional Raw SQL GIN Index Exception:
  // The PostgreSQL full-text search index:
  //   CREATE INDEX "kb_items_search_idx" ON "kb_items" USING gin(to_tsvector('english', "title" || ' ' || "content"));
  // was created in migration 20261106020000_evaluation_quality_kb.
  // Prisma Schema DSL does not support functional/expression GIN indexes (expressions with string concatenation and functions).
  // This index is preserved in the database and explicitly asserted in scripts/verify-clean-db.mjs.
  // Do NOT add a Prisma migration that alters or drops this index.
  @@index([published])
  @@index([topic])
  @@map("kb_items")
}

model EvalRun {
  id            String   @id @default(uuid()) @db.Uuid
  suiteName     String   @map("suite_name") @db.VarChar(128)
  model         String   @db.VarChar(64)
  promptVersion String   @map("prompt_version") @db.VarChar(64)
  totalCases    Int      @map("total_cases")
  passedCases   Int      @map("passed_cases")
  score         Float
  metadata      Json     @default("{}")
