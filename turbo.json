{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "AI_PROVIDER_EMBED",
        "AI_PROVIDER_PRIMARY",
        "ALLOW_LOCAL_SERVICES_IN_PRODUCTION",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_MODEL",
        "APP_MASTER_KEY",
        "APP_URL",
        "CLAMAV_ENABLED",
        "CLAMAV_HOST",
        "CLAMAV_PORT",
        "CURSOR_SIGNING_SECRET",
        "DATABASE_URL",
        "E2E_FIXTURES_ENABLED",
        "EMAIL_FROM",
        "EXTERNAL_AI_DAILY_REQUEST_LIMIT_PER_USER",
        "EXTERNAL_AI_ENABLED",
        "EXTERNAL_AI_MAX_CONCURRENCY",
        "GEMINI_API_KEY",
        "GEMINI_MODEL",
        "HIBP_ENFORCEMENT_MODE",
        "MAX_USERS",
        "PORT",
        "PREVIOUS_APP_MASTER_KEY",
        "REDIS_CACHE_URL",
        "REDIS_QUEUE_URL",
        "S3_ACCESS_KEY",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_SECRET_KEY",
        "SANDBOX_CONTAINER_RUNNER_URL",
        "SANDBOX_PROVIDER",
        "SANDBOX_SHARED_SECRET",
        "SESSION_SECRET",
        "SMTP_FROM",
        "SMTP_HOST",
        "SMTP_PASSWORD",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USER",
        "STATIC_SCRIPT_HASHES",
        "TRUSTED_PROXY_IPS"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
